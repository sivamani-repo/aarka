# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aarka_db
DB_USER=sivamani_user
DB_PASSWORD=replace_with_a_unique_database_password

# Application & Origins
APP_NAME=AARKA
APP_TAGLINE="Solar Operations, Simplified."
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
UPLOAD_DIR=uploads

# JWT Authentication & Security
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
VERIFICATION_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_MINUTES=60

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Email Service (SMTP)
# If SMTP_HOST is not set, verification links and reset links are logged to application console for local development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@aarka.com
EMAILS_FROM_NAME="AARKA Solar Operations"
